<?xml version="1.0" encoding="utf-8"?>
<pfsense>
  <version>22.5</version>
  <system>
    <hostname>fw-secure</hostname>
    <domain>example.com</domain>
    <timezone>UTC</timezone>
    <webgui>
      <protocol>https</protocol>
      <port>443</port>
    </webgui>
  </system>
  <interfaces>
    <wan>
      <enable/>
      <if>igb0</if>
      <descr>WAN</descr>
      <ipaddr>dhcp</ipaddr>
      <subnet>0</subnet>
      <ipaddrv6>none</ipaddrv6>
      <subnetv6>0</subnetv6>
    </wan>
    <lan>
      <enable/>
      <if>igb1</if>
      <descr>LAN</descr>
      <ipaddr>192.168.1.1</ipaddr>
      <subnet>24</subnet>
      <ipaddrv6>none</ipaddrv6>
      <subnetv6>0</subnetv6>
    </lan>
    <dmz>
      <enable/>
      <if>igb2</if>
      <descr>DMZ</descr>
      <ipaddr>192.168.10.1</ipaddr>
      <subnet>24</subnet>
      <ipaddrv6>none</ipaddrv6>
      <subnetv6>0</subnetv6>
    </dmz>
  </interfaces>
  <filter>
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <source>
        <any/>
      </source>
      <destination>
        <any/>
      </destination>
      <descr>Default block inbound on WAN</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <source>
        <network>lan</network>
      </source>
      <destination>
        <any/>
      </destination>
      <descr>Allow LAN to any</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>dmz</interface>
      <ipprotocol>inet</ipprotocol>
      <source>
        <network>dmz</network>
      </source>
      <destination>
        <any/>
      </destination>
      <descr>Allow DMZ to Internet</descr>
    </rule>
    <rule>
      <type>block</type>
      <interface>dmz</interface>
      <ipprotocol>inet</ipprotocol>
      <source>
        <network>dmz</network>
      </source>
      <destination>
        <network>lan</network>
      </destination>
      <descr>Block DMZ to LAN</descr>
    </rule>
  </filter>
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
  </nat>
  <syslog>
    <remoteserver>192.168.1.100</remoteserver>
    <nentries>50</nentries>
  </syslog>
  <ntp>
    <timeservers>0.pool.ntp.org 1.pool.ntp.org</timeservers>
    <enabled>enabled</enabled>
  </ntp>
</pfsense>
