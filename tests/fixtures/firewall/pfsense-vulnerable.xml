<?xml version="1.0" encoding="utf-8"?>
<pfsense>
  <version>22.5</version>
  <system>
    <hostname>fw-vulnerable</hostname>
    <domain>example.com</domain>
    <timezone>UTC</timezone>
    <webgui>
      <protocol>http</protocol>
      <port>80</port>
    </webgui>
    <ssh>
      <enable>enabled</enable>
      <port>22</port>
    </ssh>
  </system>
  <interfaces>
    <wan>
      <enable/>
      <if>igb0</if>
      <descr>WAN</descr>
      <ipaddr>dhcp</ipaddr>
      <subnet>0</subnet>
      <ipaddrv6>dhcp6</ipaddrv6>
      <subnetv6>0</subnetv6>
    </wan>
    <lan>
      <enable/>
      <if>igb1</if>
      <descr>LAN</descr>
      <ipaddr>192.168.1.1</ipaddr>
      <subnet>24</subnet>
      <ipaddrv6>none</ipaddrv6>
      <subnetv6>0</subnetv6>
    </lan>
  </interfaces>
  <filter>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source>
        <any/>
      </source>
      <destination>
        <any/>
      </destination>
      <descr>Allow anything from WAN</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <source>
        <any/>
      </source>
      <destination>
        <network>lan</network>
        <port>3389</port>
      </destination>
      <descr>Allow RDP from WAN to LAN</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <source>
        <any/>
      </source>
      <destination>
        <network>wanip</network>
        <port>22</port>
      </destination>
      <descr>Allow SSH from WAN</descr>
    </rule>
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <source>
        <any/>
      </source>
      <destination>
        <network>wanip</network>
        <port>22</port>
      </destination>
      <descr>Block SSH from WAN</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source>
        <network>lan</network>
      </source>
      <destination>
        <any/>
      </destination>
      <descr>Allow LAN to any</descr>
    </rule>
  </filter>
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
    <rule>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source>
        <any/>
      </source>
      <destination>
        <network>wanip</network>
        <port>3389</port>
      </destination>
      <target>192.168.1.50</target>
      <local-port>3389</local-port>
      <descr>Forward RDP to admin workstation</descr>
    </rule>
  </nat>
  <syslog>
    <nentries>50</nentries>
  </syslog>
  <ntp>
    <timeservers></timeservers>
    <enabled>enabled</enabled>
  </ntp>
  <openvpn>
    <openvpn-server>
      <mode>p2p_shared_key</mode>
      <protocol>UDP</protocol>
      <local_port>1194</local_port>
    </openvpn-server>
  </openvpn>
</pfsense>
